---
import type {CollectionEntry} from 'astro:content';
import BaseLayout from "./BaseLayout.astro";
import type {MarkdownHeading} from "astro";

import FormattedDate from "@/components/FormattedDate";
import Tag from "@/components/Tag";
import {Image} from "astro:assets"
import Share from "@/components/Share";

type Props = {
    id: CollectionEntry<'blog'>['id'];
    data: CollectionEntry<'blog'>['data'];
    headings: MarkdownHeading[];
    readTime: string;
}
const {data, readTime, headings, id} = Astro.props;
const {title, description, pubDate, heroImage, tags, complexity} = data;
const articleDate = pubDate.toISOString();
---

<BaseLayout
        title={title}
        description={description}
        image={heroImage}
        articleDate={articleDate}
>
    <!-- Medium Style Narrow & Centered Article Container -->
    <article class="max-w-4xl mx-auto py-8 md:py-16 px-4 font-sans text-[#292929]">
        <!-- Title and Metadata -->
        <header class="mb-8 md:mb-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-[#121212] tracking-tight leading-tight mb-4">
                {title}
            </h1>
            
            <p class="text-base text-[#495057] mb-6 leading-relaxed">
                {description}
            </p>

            <div class="flex items-center gap-3 text-xs text-[#868e96] font-medium border-b border-[#f1f3f5] pb-6">
                <span>HyeonD</span>
                <span>·</span>
                <span>
                    <FormattedDate date={pubDate}/>
                </span>
                <span>·</span>
                <span>
                    {readTime}
                </span>
                {complexity && (
                    <>
                        <span>·</span>
                        <span class="text-accent font-semibold">{complexity}</span>
                    </>
                )}
            </div>
        </header>

        <!-- Main Banner Image -->
        {heroImage && (
            <div class="mb-8">
                <Image
                    src={heroImage}
                    width={800}
                    height={450}
                    quality={90}
                    format='jpg'
                    loading='eager'
                    class='rounded w-full object-cover max-h-[350px]'
                    alt={`img of ${title}`}
                />
            </div>
        )}

        <!-- Medium Style Markdown Prose Content -->
        <div class="leading-relaxed text-[#292929] max-w-none">
            <slot/>
        </div>

        <!-- Tags & Share Footer -->
        <footer class="mt-12 pt-6 border-t border-[#f1f3f5] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex flex-wrap gap-2">
                {tags.map((tag: string) => (
                    <span class="text-xs px-2.5 py-1 rounded bg-[#f1f3f5] text-[#495057] font-medium">
                        #{tag}
                    </span>
                ))}
            </div>
            <div class="shrink-0">
                <Share />
            </div>
        </footer>
    </article>
</BaseLayout>
