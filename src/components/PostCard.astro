---
import { Image } from 'astro:assets'
import FormattedDate from '@/components/FormattedDate'

const {
	id,
	data: { title, description, pubDate, heroImage, category },
	readTime,
	slug
} = Astro.props
---

<article class='velog-card flex flex-col h-full group border border-[#f1f3f5]'>
	
	<!-- Hero Image Area -->
	<a class='relative block overflow-hidden aspect-video bg-[#f8f9fa] shrink-0' href={`/blog/${slug}/`}>
		{heroImage ? (
			<Image
				src={heroImage}
				width={600}
				height={300}
				format='webp'
				class='h-full w-full object-cover group-hover:scale-[102%] transition-transform duration-300'
				alt={`img of ${title}`}
			/>
		) : (
			<div class='h-full w-full flex items-center justify-center text-zinc-300 text-xs font-sans'>
				No Image
			</div>
		)}
	</a>

	<!-- Info Area -->
	<div class='p-4 flex flex-col justify-between flex-1 bg-white'>
		<div class='flex-1'>
			<a class='block text-base font-bold text-[#121212] leading-snug line-clamp-2 mb-2 group-hover:text-accent transition-colors' href={`/blog/${slug}/`}>
				{title}
			</a>
			<p class='text-xs text-[#495057] line-clamp-3 leading-relaxed mb-4'>
				{description}
			</p>
		</div>

		<!-- Card Footer (Velog Style Meta) -->
		<div class='flex items-center justify-between pt-3 border-t border-[#f1f3f5] text-[11px] text-[#868e96]'>
			<div class='flex items-center gap-1.5'>
				<FormattedDate date={pubDate} />
				<span>·</span>
				<span>{readTime}</span>
			</div>
			<span class='px-2 py-0.5 rounded bg-[#f8f9fa] text-[#495057] font-medium'>
				{category}
			</span>
		</div>
	</div>

</article>