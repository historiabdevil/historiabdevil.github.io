---
interface Props {
  title: string;
  description: string;
  tags: string[];
  metrics?: { label: string; value: string }[];
  link?: string;
  repoLink?: string;
}

const { title, description, tags, metrics, link, repoLink } = Astro.props;
---

<div class="py-6 medium-border-bottom flex flex-col md:flex-row md:items-start justify-between gap-4 group">
  <div class="flex-1">
    <!-- Title -->
    <div class="flex items-center gap-3 mb-1">
      <h3 class="text-lg font-bold text-[#121212] group-hover:text-accent transition-colors duration-150">
        {title}
      </h3>
      {repoLink && (
        <a href={repoLink} target="_blank" rel="noopener noreferrer" class="text-[#868e96] hover:text-[#212529] transition-colors" title="Github Repository">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z" clip-rule="evenodd"/></svg>
        </a>
      )}
    </div>

    <!-- Description -->
    <p class="text-sm text-[#495057] leading-relaxed mb-3 max-w-2xl font-sans">
      {description}
    </p>

    <!-- Meta info & metrics & tags (Medium footer style) -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#868e96]">
      <!-- Metrics -->
      {metrics && metrics.length > 0 && (
        <div class="flex items-center gap-3 mr-2">
          {metrics.map((metric) => (
            <span class="inline-flex items-center">
              <span class="text-[#a0aec0] font-sans mr-1">{metric.label}:</span>
              <span class="font-bold text-[#495057]">{metric.value}</span>
            </span>
          ))}
        </div>
      )}
      
      <!-- Tags -->
      <div class="flex gap-2">
        {tags.map((tag) => (
          <span class="text-accent font-medium">
            #{tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>
