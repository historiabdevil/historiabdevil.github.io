---
import {getPosts} from '@/utils'
import Thumbnail from "./Thumbnail.astro";
import type { CollectionEntry } from 'astro:content';
const posts = await getPosts()
const typedPosts = posts as CollectionEntry<'blog'>[]
console.log(posts)
---
<div id="post-list-container" class="flex flex-col gap-8">
    {
        typedPosts.map((post) => {
            return (
                    <Thumbnail title={post.data.title} slug={post.id} description={post.data.description}
                               heroImage={post.data.heroImage} pubDate={post.data.pubDate} tags={post.data.tags}
                    />
            )
        })
    }
</div>