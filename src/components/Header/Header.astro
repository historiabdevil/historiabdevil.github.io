---
import HeaderLink from './HeaderLink.astro';
import {SITE_TITLE} from '../../consts';
import Github from '../icons/Github.astro';
import Rss from '../icons/Rss.astro';
import Instagram from '../icons/Instagram.astro';
import Facebook from '../icons/Facebook.astro';
import Twitter from '../icons/Twitter.astro';
---
<header class="">
    <div class="max-w-6xl mx-auto flex items-end justify-between px-4 gap-5">
        <div class="flex flex-row items-center gap-3">
            <a href="/"><img class="w-10" src="/images/logo.png"/></a>
            <h1 class="text-2xl font-bold">{SITE_TITLE}</h1>
        </div>
        <div class="flex flex-row gap-5">
            <div class="flex flex-row items-center justify-evenly gap-4">
                <a href="https://github.com/historiabdevil" target="_blank" rel="noopener noreferrer" class="hover:text-teal-500 dark:hover:text-teal-400 transition-colors">
                    <span class="w-5 h-5 block"><Github/></span>
                </a>
                <a href="/rss.xml" target="_blank" class="hover:text-teal-500 dark:hover:text-teal-400 transition-colors">
                    <span class="w-5 h-5 block"><Rss/></span>
                </a>
            </div>
        </div>
    </div>
</header>
<style>
</style>
