---
import { getTagsWithCount, type TagInfo } from '../utils/post';

interface Props {
  activeTag?: string;
}

const { activeTag = 'All' } = Astro.props;
const tags = await getTagsWithCount();
---

<div class="space-y-4 font-sans">
  <div class="pb-2 border-b border-[#f1f3f5] flex items-center justify-between">
    <h3 class="text-xs font-bold text-[#868e96] uppercase tracking-wider">Tags</h3>
  </div>

  <!-- Search Tag Input -->
  <div class="relative">
    <input
      type="text"
      id="tag-search"
      placeholder="태그 검색..."
      class="w-full px-3 py-1.5 bg-[#f8f9fa] border border-[#e9ecef] rounded text-xs text-[#212529] placeholder-[#adb5bd] focus:outline-none focus:border-accent/40 transition-colors"
      autocomplete="off"
    />
  </div>
  
  <!-- Tags List -->
  <ul id="tag-list" class="space-y-1.5 text-[13px] font-sans">
    {tags.map((tag: TagInfo) => {
      const isSelected = activeTag.toLowerCase() === tag.name.toLowerCase();
      // 'All' 클릭 시 루트(/)로, 그 외 태그는 태그 검색 페이지로 이동
      const href = tag.name === 'All' ? '/' : `/tags/${tag.name.toLowerCase()}`;
      
      return (
        <li data-tag-name={tag.name.toLowerCase()}>
          <a
            href={href}
            class={`flex items-center justify-between py-1 px-1 transition-all duration-150 group ${
              isSelected
                ? 'text-black font-bold underline decoration-zinc-400 decoration-1 underline-offset-4'
                : 'text-[#212529] hover:underline hover:text-black decoration-zinc-300 decoration-1 underline-offset-4'
            }`}
          >
            <span>{tag.name}</span>
            <span class={`text-[11px] ${isSelected ? 'text-black font-bold' : 'text-[#868e96]'} font-mono`}>
              {tag.count}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</div>

<script>
  const setupTagFilters = () => {
    const searchInput = document.getElementById('tag-search') as HTMLInputElement | null;
    const tagList = document.getElementById('tag-list');
    
    if (!tagList) return;

    const tagItems = tagList.querySelectorAll('li');
    const postCards = document.querySelectorAll('.post-card');

    // 1. 태그 검색 기능
    if (searchInput) {
      // 기존에 입력된 값이 있다면 초기 필터링 적용을 대비해 분리
      const handleSearch = () => {
        const value = searchInput.value.toLowerCase().trim();
        tagItems.forEach((item) => {
          const tagName = item.getAttribute('data-tag-name') || '';
          if (tagName === 'all') {
            item.style.display = 'block';
            return;
          }
          if (tagName.includes(value)) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      };
      searchInput.addEventListener('input', handleSearch);
    }

    // 2. 태그 클릭 핸들러 (클라이언트 필터링)
    const anchors = tagList.querySelectorAll('a');
    anchors.forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        // 이 페이지에 포스트 카드가 없으면(예: 상세페이지 등) 일반 링크 이동 허용
        if (postCards.length === 0) return;

        e.preventDefault();

        const li = anchor.closest('li');
        if (!li) return;

        const selectedTag = li.getAttribute('data-tag-name') || 'all';

        // 2-1. 태그 목록 UI 활성화/비활성화 클래스 전환
        anchors.forEach((a) => {
          const isCurrSelected = a === anchor;
          const countSpan = a.querySelector('span:last-child');
          
          if (isCurrSelected) {
            a.className = 'flex items-center justify-between py-1 px-1 transition-all duration-150 group text-black font-bold underline decoration-zinc-400 decoration-1 underline-offset-4';
            if (countSpan) {
              countSpan.className = 'text-[11px] text-black font-bold font-mono';
            }
          } else {
            a.className = 'flex items-center justify-between py-1 px-1 transition-all duration-150 group text-[#212529] hover:underline hover:text-black decoration-zinc-300 decoration-1 underline-offset-4';
            if (countSpan) {
              countSpan.className = 'text-[11px] text-[#868e96] font-mono';
            }
          }
        });

        // 2-2. 포스트 카드 필터링
        postCards.forEach((card) => {
          const htmlCard = card as HTMLElement;
          const cardTagsStr = htmlCard.getAttribute('data-tags') || '';
          const cardTags = cardTagsStr.split(',');

          if (selectedTag === 'all') {
            htmlCard.style.display = 'flex';
          } else {
            if (cardTags.includes(selectedTag)) {
              htmlCard.style.display = 'flex';
            } else {
              htmlCard.style.display = 'none';
            }
          }
        });
      });
    });
  };

  // Astro 초기 마운트 및 페이지 스왑 시 정상 바인딩
  setupTagFilters();
  document.addEventListener('astro:after-swap', setupTagFilters);
</script>
