---
import { siteConfig } from '@/data/site.config'
import TwitterColorIcon from './icons/Twitter.astro'
import Instagram from "./icons/Instagram.astro";
const message = siteConfig.shareMessage

const URL = Astro.url.href
---

<div class='flex items-center gap-2 text-xs font-sans'>
	<span class='text-zinc-400 font-medium mr-1 select-none'>Share:</span>
	<ul class='flex gap-2 text-[#495057]'>
		<li>
			<a
				href={`https://twitter.com/intent/tweet?text=${message + ' ' + URL}`}
				aria-label='Share on Twitter'
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-[#f8f9fa] border border-[#e9ecef] hover:bg-[#f1f3f5] hover:text-[#121212] transition-colors"
			>
				<span class="w-3 h-3 text-zinc-500 flex items-center justify-center shrink-0">
					<TwitterColorIcon />
				</span>
				<span class="text-[10px] font-medium">X</span>
			</a>
		</li>
		<li>
			<a
				href={`https://www.linkedin.com/shareArticle?mini=true&url=${URL}`}
				aria-label='Share on LinkedIn'
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-[#f8f9fa] border border-[#e9ecef] hover:bg-[#f1f3f5] hover:text-[#121212] transition-colors"
			>
				<span class="w-3 h-3 text-zinc-500 flex items-center justify-center shrink-0">
					<Instagram />
				</span>
				<span class="text-[10px] font-medium">LinkedIn</span>
			</a>
		</li>
	</ul>
</div>