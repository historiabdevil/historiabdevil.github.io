---
// Velog 스타일의 미니멀 프로필 영역
---
<div class="w-full max-w-3xl mx-auto py-10 md:py-16 flex flex-col md:flex-row items-center md:items-start gap-6 medium-border-bottom pb-10">
  
  <!-- Left Side: Profile Icon (Elegant Circle) -->
  <div class="w-20 h-20 md:w-24 md:h-24 rounded-full overflow-hidden flex items-center justify-center select-none shrink-0 border border-zinc-200 bg-zinc-100">
    <img src="/images/logo.png" alt="HyeonD Avatar" class="w-full h-full object-cover" />
  </div>

  <!-- Right Side: Profile Info -->
  <div class="flex-1 text-center md:text-left">
    <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 justify-center md:justify-start">
      <h1 class="text-2xl font-bold text-[#121212]">HyeonD</h1>
      <span class="inline-flex items-center self-center md:self-auto px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-50 text-accent border border-teal-100">
        Backend Engineer
      </span>
    </div>
    
    <p class="mt-4 text-[#495057] text-sm md:text-base leading-relaxed max-w-xl font-sans">
    </p>

    <!-- Social / Github minimalist links -->
    <div class="mt-4 flex justify-center md:justify-start gap-4 text-xs font-mono text-zinc-400">
      <a href="https://github.com/historiabdevil" target="_blank" rel="noopener noreferrer" class="hover:text-accent hover:underline transition-all">
        github
      </a>
      <span>·</span>
      <a href="mailto:hyeond@example.com" class="hover:text-accent hover:underline transition-all">
        email
      </a>
    </div>
  </div>

</div>
