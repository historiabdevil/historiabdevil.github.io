---
import FormattedDate from "./FormattedDate.astro";
const {title, description, heroImage, slug, pubDate, tags = []} = Astro.props
---

<div class="py-8 medium-border-bottom flex flex-col gap-4 group post-card" data-tags={tags.map((t: string) => t.toLowerCase()).join(',')}>
    <!-- Main Image (Top Side, Wide aspect) -->
    {heroImage && (
        <a href=`/blog/${slug}` class="block w-full max-h-56 md:max-h-64 aspect-video rounded-lg overflow-hidden bg-[#f8f9fa] border border-[#f1f3f5]">
            <img class="h-full w-full object-cover group-hover:scale-[101%] transition-transform duration-300" src={heroImage} alt={title} />
        </a>
    )}

    <!-- Text Contents (Bottom Side) -->
    <div class="space-y-2">
        <div class="text-[11px] text-[#868e96] font-sans flex items-center gap-1.5">
            <span class="font-bold text-[#495057]">HyeonD</span>
            <span>·</span>
            <FormattedDate date={pubDate}/>
        </div>
        
        <a href=`/blog/${slug}` class="block">
            <h3 class="text-xl md:text-2xl font-extrabold text-[#121212] group-hover:text-accent transition-colors duration-150 leading-snug">
                {title}
            </h3>
        </a>
        
        <p class="text-sm md:text-base text-[#495057] leading-relaxed line-clamp-3 font-sans">
            {description}
        </p>
    </div>
</div>
